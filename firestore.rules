rules_version = '2';
// PFD Protocols — private by design.
// Protocol content is readable ONLY by signed-in users whose email is on the
// allowlist. The allowlist itself is readable by allowlisted users (so the app
// can check membership) and writable only by admins.
// Doc IDs in `allowlist` are the lowercased email address.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function myEmail() { return request.auth.token.email.lower(); }
    function allowlisted() {
      return signedIn()
        && exists(/databases/$(database)/documents/allowlist/$(myEmail()));
    }
    function isAdmin() {
      return allowlisted()
        && get(/databases/$(database)/documents/allowlist/$(myEmail())).data.role == 'admin';
    }

    match /protocols/{docId} {
      allow read: if allowlisted();
      allow create, update, delete: if isAdmin();
    }

    match /allowlist/{email} {
      allow read: if allowlisted();
      // Admins manage the list. No self-registration: create requires admin.
      allow create, update, delete: if isAdmin();
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
